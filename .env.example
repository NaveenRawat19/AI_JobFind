LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
SCREEN_MODEL=gemini-3.5-flash-lite
DRAFT_MODEL=gemini-3.6-flash

# To use Grok (xAI) instead: set LLM_PROVIDER=xai, add the key, and change the two
# model names above (grok-4.3 / grok-4.7 are the defaults if you leave them unset).
# XAI_API_KEY=paste-your-xai-api-key-here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_TO=your-email@gmail.com